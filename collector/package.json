{
  "name": "ecosine-fleet-collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Collector agents that backfill and auto-update Ecosine/Egari fleet data from Uber, Yango, Bolt, FMS and CABMAN into Postgres.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "migrate": "node src/index.js migrate",
    "backfill": "node src/index.js backfill",
    "incremental": "node src/index.js incremental",
    "start": "node src/index.js schedule",
    "api": "node api/server.js",
    "check": "node --check src/index.js",
    "smoke": "node test/smoke_views.mjs",
    "test": "node test/run-all.mjs",
    "audit:pages": "node bin/page-audit.mjs",
    "audit:live": "node bin/live-audit.mjs",
    "smoke:views": "node test/smoke_views.mjs",
    "live-ui": "node bin/live-ui.mjs",
    "mutate": "node bin/mutate.mjs"
  },
  "dependencies": {
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-cron": "^3.0.3",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "playwright": "^1.62.1"
  }
}
