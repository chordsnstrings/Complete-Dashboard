node_modules/
.env
*.log
test/*.png

# Scratch workspaces written by agents while measuring: bench harnesses, .orig
# copies of a file under test, throwaway fixtures. Transient by construction —
# an agent builds one to prove a before/after and abandons it. Ignored rather
# than committed so a measurement in progress never lands in the branch.
.bench/
.verify/

# bin/access-gateway.mjs keeps production's answers on disk between sweeps.
# They are real data (names, plates, money) and never belong in the repository.
.gateway-cache/
