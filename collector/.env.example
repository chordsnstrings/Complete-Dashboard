# ── Collector credentials ── copy to `.env` and fill in. NEVER commit the real .env.
# Rotate any credential that has been shared in plaintext.

# Postgres (compose sets PGHOST=db automatically)
PGPASSWORD=fleet
# DATABASE_URL=postgres://fleet:fleet@db:5432/fleet   # optional override

# Backfill / cadence
BACKFILL_MONTHS=12
INCREMENTAL_DAYS=3
CABMAN_CRON=*/5 * * * *      # CABMAN realtime GPS refresh — every 5 minutes, saved to DB
LIVE_STATUS_SECONDS=120      # Uber/FMS live-status poll interval

# ── FMS / InfoTrack (both fleets) ──
FMS_ECOSINE_PASS=
FMS_EGARI_PASS=

# ── CABMAN DT (realtime; Ecosine has creds, add Egari in config when available) ──
CABMAN_ECOSINE_PASS=

# ── Uber (Ecosine) ──
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_ORG_ENCRYPTED=          # encrypted org id used by api.uber.com (?org_id=)
UBER_ORG_UUID=               # plaintext org uuid used by graphql + reports
UBER_WEB_COOKIE=             # supplier.uber.com session cookie (expires — refresh via supervisor)

# ── Yango (Ecosine park) ──
YANGO_PARK_ID=
YANGO_API_KEY=
YANGO_COOKIE=                # Yandex session cookie (expires — refresh via supervisor)

# ── Bolt ──
BOLT_CLIENT_ID=
BOLT_CLIENT_SECRET=
BOLT_REFRESH_TOKEN=          # fleet-owner-portal refresh token (~7d). Empty = skip trips/earnings.
